# FR : Copier ce fichier en `.env` a la racine du repo et remplir les valeurs.
#      Jamais commiter le vrai `.env` (voir .gitignore).
# EN : Copy this file to `.env` at the repo root and fill in the values.
#      Never commit the real `.env` (see .gitignore).

# --- Chaine source / Source chain : Ethereum Sepolia ---
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/<votre_cle_infura>
# FR : identifiant interne Attestcoin pour Sepolia (different du chainId EVM 11155111).
# EN : Attestcoin-internal identifier for Sepolia (different from EVM chainId 11155111).
SEPOLIA_CHAIN_KEY=1

# --- Chaine destination / Destination chain : Creditcoin CC3 Testnet ---
CREDITCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
CREDITCOIN_PROVER_URL=https://prover.cc3-testnet.creditcoin.network

# --- Cles privees de test (testnet uniquement, jamais de fonds reels) ---
# --- Test private keys (testnet only, never real funds) ---
DEPLOYER_PRIVATE_KEY=0x...
CLIENT_PRIVATE_KEY=0x...
FREELANCER_ADDRESS=0x...

# --- Adresses deployees (remplies apres l'etape de deploiement) ---
# --- Deployed addresses (filled in after the deployment step) ---
ESCROW_ADDRESS=
ASC_ESCROW_VERIFIER_ADDRESS=
SOURCE_MILESTONE_ADDRESS=
