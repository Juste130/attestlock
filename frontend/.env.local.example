# FR : Copier en `.env.local` dans frontend/ (convention Next.js -- separe du .env racine
#      utilise par contracts/ et scripts/, car Next.js n'inline les variables NEXT_PUBLIC_*
#      dans le bundle navigateur qu'a partir de SES PROPRES fichiers .env*).
# EN : Copy to `.env.local` inside frontend/ (Next.js convention -- separate from the root
#      .env used by contracts/ and scripts/, because Next.js only inlines NEXT_PUBLIC_*
#      variables into the browser bundle from ITS OWN .env* files).

# --- Exposees au navigateur / Exposed to the browser ---
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/<votre_cle_infura>
NEXT_PUBLIC_CREDITCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
NEXT_PUBLIC_SEPOLIA_CHAIN_KEY=1
NEXT_PUBLIC_ESCROW_ADDRESS=
NEXT_PUBLIC_ASC_ESCROW_VERIFIER_ADDRESS=
NEXT_PUBLIC_SOURCE_MILESTONE_ADDRESS=

# --- Cote serveur uniquement (route /api/prove) / Server-side only (/api/prove route) ---
CREDITCOIN_PROVER_URL=https://prover.cc3-testnet.creditcoin.network
# FR : Paie le gas pour soumettre les preuves -- ne finance jamais l'escrow, n'a aucun droit
#      particulier (execute() est permissionless). Jamais expose au navigateur.
# EN : Pays gas to submit proofs -- never funds the escrow, has no special rights (execute()
#      is permissionless). Never exposed to the browser.
RELAYER_PRIVATE_KEY=0x...
